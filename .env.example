# Copy to .env and enter credentials locally. Never commit .env or paste secrets into chat.
# Relay Agent Token (for the exact agent you will message; Console login is separate).
RELAY_AGENT_TOKEN=
# Relay production origin, without /v1; use the issuing environment for your token.
RELAY_API_URL=https://api.relayapp.im
# Standard Webhooks whsec_ signing secret, from local CLI forwarding or the production subscription.
RELAY_WEBHOOK_SECRET=
# Supabase project URL and server-only secret key (sb_secret_..., or legacy service_role key).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Google AI Studio Gemini API key (server-side only).
GEMINI_API_KEY=
# Normal text replies use 3.6; 3.5 is tried if the primary model fails.
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Separate vision setting for closet videos. Image generation is a later feature.
GEMINI_VISION_MODEL=gemini-3.6-flash
# connection runs the fixed hello test without a Gemini key; stylist enables all implemented flows.
CONVERSATION_MODE=stylist
PORT=3000
